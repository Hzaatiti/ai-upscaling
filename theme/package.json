{
  "name": "slidev-theme-nyu",
  "version": "0.1.0",
  "description": "Slidev theme for the NYU upscaling workshop series.",
  "keywords": [
    "slidev-theme",
    "slidev",
    "nyu"
  ],
  "slidev": {
    "colorSchema": "both",
    "highlighter": "shiki"
  },
  "main": "example.md",
  "scripts": {
