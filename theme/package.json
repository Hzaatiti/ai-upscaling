    "build": "slidev build example.md",
    "export": "slidev export example.md"
  },
  "devDependencies": {
    "@slidev/cli": "^0.49.0",
    "@slidev/types": "^0.49.0",
    "vue": "^3.4.0"
  },
  "files": [
    "layouts",
    "components",
    "styles",
    "setup",
    "public",
    "example.md"
  ]
}
